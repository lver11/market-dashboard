{  
  "$comment": "Windows-specific MCP configuration. Copy this to .mcp.json on Windows systems. cmd /c automatically loads PATH from system environment.",
  "mcpServers": {
    "context7": {
      "$comment": "Windows uses cmd /c which loads PATH automatically (no shell wrapper needed)",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @upstash/context7-mcp@latest"
      ]
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "stitch": {
      "command": "cmd",
      "args": [
        "/c",
        "npx -y stitch-mcp"
      ],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "YOUR_PROJECT_ID"
      }
    },
    "memory": {
      "$comment": "Persistent memory across sessions for user preferences, project context, and learned patterns",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-memory"
      ]
    },       
    "exa": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": ""
      }
    },
    "filesystem": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\project\\vibeShop-source"]
    },
    "github": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },   
    "wolfram-alpha": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "WOLFRAM_ALPHA_APPID", "mcp/server/wolfram-alpha"],
      "env": {
        "WOLFRAM_ALPHA_APPID": ""
      }
    }
  },
  "staggeredStartup": {
    "enabled": true,
    "delayMs": 500,
    "connectionTimeout": 15000
  }
}