name: Deploy to Vercel

on:
  push:
    branches:
      - main

  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          
      - name: Install Vercel CLI
        run: npm install --global vercel@latest
          
      - name: Pull Vercel Environment Variables
        id: vercel-env
        run: |
          echo "VERCEL_ORG_ID=$(npx vercel orgs ls --json | head -1)"
          echo "VERCEL_PROJECT_ID=$(npx vercel ls --json | grep -oE '\"name\":\".*?DashBoard\"' | grep -oE '\"id\":\"[0-9]+')"
          echo "$VERCEL_ORG_ID" >> $GITHUB_OUTPUT
          echo "$VERCEL_PROJECT_ID" >> $GITHUB_OUTPUT
          
      - name: Deploy to Vercel (Production)
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_ORG_ID: ${{ steps.vercel-env.outputs.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ steps.vercel-env.outputs.VERCEL_PROJECT_ID }}
        run: |
          echo "🚀 Deploying to Vercel Production..."
          echo "📋 Project ID: $VERCEL_PROJECT_ID"
          npx vercel deploy --prod --yes --token=$VERCEL_TOKEN
          
      - name: Deployment Summary
        if: always()
        run: |
          echo "## 📊 Deployment Summary"
          echo ""
          echo "- **Status**: ${{ job.status }}"
          echo "- **Timestamp**: $(date -u +'%Y-%m-%d %H:%M:%S UTC')"
          echo "- **Environment**: Production"
          echo ""
          echo "### 🔍 Logs"
          echo "Check Vercel dashboard for detailed logs:"
          echo "https://vercel.com/dashboard"
